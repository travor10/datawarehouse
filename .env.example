# =============================================================================
# Aura Cleaning Solutions Data Mart - Environment Configuration
# =============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' and update the values to match your local setup:
#   copy .env.example .env      (Windows Command Prompt)
#   cp .env.example .env        (PowerShell / Linux / macOS)
# =============================================================================

# Primary Database Engine:
# Options: 'mysql' (Production Authoritative - MySQL 8) or 'sqlite' (Local Unit Testing)
DB_ENGINE=mysql

# MySQL 8 Server Credentials (Authoritative Data Mart Database)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aura_data_mart
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# SQLite Database Path (Used for local test runner and isolated dry runs)
SQLITE_DB_PATH=database/aura_data_mart_test.db

# Application and ETL Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ETL Batch Control
ETL_STRICT_MODE=True
